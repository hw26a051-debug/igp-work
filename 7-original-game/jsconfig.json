{
  // このプロジェクトは index.html が <script> タグを並べて読み込み、
  // 全てのファイルが 1 つのグローバルスコープを共有する構成になっている。
  // このファイルを置くことで、VS Code は、このファイルがあるフォルダ以下の
  // すべての JS ファイルを 1 つのプロジェクトとして認識する。
  // その結果、ファイルをまたいだ関数・変数でも「定義へ移動」(F12)や
  // 入力補完が効き、変数名の変更 (F2) の影響もこのフォルダの中だけに収まる。
  // 対象のファイルを絞る "include" はあえて指定していない。
  // 省略すると、後から作ったファイルも自動的にこのプロジェクトに含まれる。
  "compilerOptions": {
    "target": "ES2020",
    // p5.js は型定義を持たずに CDN から読み込んでいるため、
    // 型チェックは行わない。
    "checkJs": false
  }
}